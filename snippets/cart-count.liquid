{% liquid
  capture pillow_count
    render 'cart-pillow-count'
  endcapture
  assign pillow_count = pillow_count | strip | plus: 0

  assign class = class
  if pillow_count > 99
    assign class = class | append: ' cart-count--small-medium'
  endif
  if cart.empty?
    assign class = class | append: ' hidden'
  endif
%}

<cart-count
  class="cart-count {{ class }}"
  {% if in_drawer %}
    data-context="drawer"
  {% endif %}
>
  <span class="visually-hidden">
    {{- 'accessibility.cart_count' | t -}}
    : {{ pillow_count }}
  </span>
  <span
    class="cart-bubble__text-count"
    ref="cartBubbleCount"
    aria-hidden="true"
  >
    {% if pillow_count < 100 %}
      {{- pillow_count -}}
    {% else %}
      99+
    {% endif %}
  </span>
</cart-count>
