{%- doc -%}
  Renders small clickable "stuks" pills for a product card, linking to the
  sibling quantity-variant products (e.g. 1 / 2 / 4 / 6 / 10 stuks).

  @param {object} product - The product to look up the quantity family for.

  @example
  {% render 'product-card-quantity-picker', product: product %}
{%- enddoc -%}
{%- liquid
  assign current_sku = product.selected_or_first_available_variant.sku
-%}
{%- capture pairs -%}{% render 'bundle-quantity-family', sku: current_sku %}{%- endcapture -%}
{%- assign pairs = pairs | strip -%}
{%- if pairs != blank -%}
  {%- assign entries = pairs | split: ';' -%}
  <div class="product-card-quantity-picker product-card-quantity-picker--{{ product.id }} flex flex-wrap gap-1">
    {%- for entry in entries limit: 4 -%}
      {%- assign entry_parts = entry | split: '|' -%}
      {%- assign qty = entry_parts[0] -%}
      {%- assign sibling = all_products[entry_parts[1]] -%}
      {%- assign extra_class = '' -%}
      {%- if forloop.index == 4 -%}
        {%- assign extra_class = ' product-card-quantity-picker__option--desktop-only' -%}
      {%- endif -%}
      {%- if sibling != blank -%}
        {%- if qty == '1' -%}
          {%- assign qty_label = '1 stuk' -%}
        {%- else -%}
          {%- assign qty_label = qty | append: ' stuks' -%}
        {%- endif -%}
        {%- if sibling.handle == product.handle -%}
          <span class="product-card-quantity-picker__option product-card-quantity-picker__option--active{{ extra_class }}" aria-current="true">{{ qty_label }}</span>
        {%- else -%}
          <a href="{{ sibling.url }}" class="product-card-quantity-picker__option{{ extra_class }}" onclick="event.stopPropagation();">{{ qty_label }}</a>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if entries.size > 4 -%}
      {%- assign extra_count = entries.size | minus: 4 -%}
      {%- assign next_entry_parts = entries[4] | split: '|' -%}
      {%- assign next_sibling = all_products[next_entry_parts[1]] -%}
      {%- if next_sibling != blank -%}
        <a href="{{ next_sibling.url }}" class="product-card-quantity-picker__option product-card-quantity-picker__option--more product-card-quantity-picker__option--desktop-only" onclick="event.stopPropagation();">+{{ extra_count }}</a>
      {%- else -%}
        <span class="product-card-quantity-picker__option product-card-quantity-picker__option--more product-card-quantity-picker__option--desktop-only">+{{ extra_count }}</span>
      {%- endif -%}
    {%- endif -%}
    {%- if entries.size > 3 -%}
      {%- assign extra_count_mobile = entries.size | minus: 3 -%}
      {%- assign next_entry_parts_mobile = entries[3] | split: '|' -%}
      {%- assign next_sibling_mobile = all_products[next_entry_parts_mobile[1]] -%}
      {%- if next_sibling_mobile != blank -%}
        <a href="{{ next_sibling_mobile.url }}" class="product-card-quantity-picker__option product-card-quantity-picker__option--more product-card-quantity-picker__option--mobile-only" onclick="event.stopPropagation();">+{{ extra_count_mobile }}</a>
      {%- else -%}
        <span class="product-card-quantity-picker__option product-card-quantity-picker__option--more product-card-quantity-picker__option--mobile-only">+{{ extra_count_mobile }}</span>
      {%- endif -%}
    {%- endif -%}
  </div>
  <style>
    .product-card-quantity-picker--{{ product.id }} {
      position: relative;
      z-index: 2;
      margin-block-end: 4px;
    }

    .product-card-quantity-picker--{{ product.id }} .product-card-quantity-picker__option {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 3px 8px;
      border-radius: 4px;
      border: 1px solid rgb(var(--color-border) / 0.3);
      font-size: 1.1rem;
      line-height: 1.4;
      text-decoration: none;
      color: rgb(var(--color-foreground));
      transition: border-color var(--animation-duration--medium, 240ms) var(--animation-easing--smooth, ease),
        background-color var(--animation-duration--medium, 240ms) var(--animation-easing--smooth, ease),
        color var(--animation-duration--medium, 240ms) var(--animation-easing--smooth, ease);
    }

    @media (hover: hover) and (pointer: fine) {
      .product-card-quantity-picker--{{ product.id }} a.product-card-quantity-picker__option:hover {
        border-color: rgb(var(--color-popular-badge-background));
        background-color: rgb(var(--color-popular-badge-background) / 0.08);
      }
    }

    .product-card-quantity-picker--{{ product.id }} .product-card-quantity-picker__option--active {
      background-color: rgb(var(--color-popular-badge-background));
      border-color: rgb(var(--color-popular-badge-background));
      color: rgb(var(--color-popular-badge-text));
      font-weight: 600;
    }

    .product-card-quantity-picker--{{ product.id }} .product-card-quantity-picker__option--more {
      border-style: dashed;
      color: rgb(var(--color-foreground) / 0.6);
    }

    .product-card-quantity-picker--{{ product.id }} .product-card-quantity-picker__option--mobile-only {
      display: none;
    }

    @media screen and (max-width: 749px) {
      .product-card-quantity-picker--{{ product.id }} .product-card-quantity-picker__option--desktop-only {
        display: none;
      }

      .product-card-quantity-picker--{{ product.id }} .product-card-quantity-picker__option--mobile-only {
        display: inline-flex;
      }
    }
  </style>
{%- endif -%}
