{%- liquid
  assign enable_filtering = section.settings.enable_filtering
  assign columns = 3
  assign columns_mobile = 2
  assign filter_type = section.settings.filter_type | default: 'vertical'
  assign enable_grid_banner = section.settings.enable_grid_banner
  assign grid_banner_position = section.settings.grid_banner_position
  assign grid_banner_width = section.settings.grid_banner_width | default: '3'
  assign grid_banner_full_width = false
  if grid_banner_width == '3'
    assign grid_banner_full_width = true
  endif
  assign grid_banner_alt = section.settings.grid_banner_title | default: shop.name
  assign grid_banner_image_class = ''
  assign grid_banner_card_classes = 'collection-grid-banner h-full'
  assign grid_banner_li_class = 'col-span-' | append: grid_banner_width | append: ' self-stretch'
  if grid_banner_full_width
    assign grid_banner_image_class = 'media-max-h-240'
    assign grid_banner_card_classes = 'collection-grid-banner'
    assign grid_banner_li_class = 'col-span-' | append: grid_banner_width
  endif
  assign grid_banner_shape_style = ''
  if section.settings.grid_banner_show_shape
    assign grid_banner_li_class = grid_banner_li_class | append: ' collection-grid-banner--shape'
    assign grid_banner_shape_style = '--shape-color: ' | append: section.settings.grid_banner_shape_color | append: ';'
  endif
-%}
{%- capture grid_banner_subheading -%}
  {% render 'text',
    text: section.settings.grid_banner_subtitle,
    preset: 'text-subheading',
    text_color: 'gradient',
    text_color_gradient: section.settings.grid_banner_subtitle_color
  %}
{%- endcapture -%}
{%- capture grid_banner_heading -%}
  {% render 'text',
    text: section.settings.grid_banner_title,
    preset: section.settings.grid_banner_title_preset,
    font_family: section.settings.grid_banner_title_font,
    font_weight: section.settings.grid_banner_title_font_weight,
    font_size: section.settings.grid_banner_title_font_size,
    font_size_mobile: section.settings.grid_banner_title_font_size_mobile,
    line_height: section.settings.grid_banner_title_line_height,
    text_color: 'gradient',
    text_color_gradient: section.settings.grid_banner_title_color,
    highlight_style: section.settings.grid_banner_title_highlight_style,
    highlight_font_style: section.settings.grid_banner_title_highlight_font_style,
    highlight_shape_color: section.settings.grid_banner_title_highlight_shape_color,
    highlight_text_color: section.settings.grid_banner_title_highlight_text_color
  %}
{%- endcapture -%}
{%- capture grid_banner_text -%}
  {% render 'text', text: section.settings.grid_banner_text, preset: 'rte' %}
{%- endcapture -%}
{%- capture grid_banner_image_html -%}
  {% render 'responsive-image',
    mode: 'liquid',
    image: section.settings.grid_banner_image,
    image_mobile: section.settings.grid_banner_image_mobile,
    image_ratio: section.settings.grid_banner_image_ratio,
    sizes: '100vw',
    default_alt: grid_banner_alt,
    class: grid_banner_image_class
  %}
{%- endcapture -%}
{%- capture grid_banner_overlay_html -%}
  {%- if section.settings.grid_banner_overlay -%}
    {% render 'overlay', overlay_color: section.settings.grid_banner_overlay_color %}
  {%- endif -%}
{%- endcapture -%}
{%- capture grid_banner_button -%}
  {%- if section.settings.grid_banner_button_link != blank -%}
    <div class="collection-grid-banner__arrow">
      {% render 'button',
        link: section.settings.grid_banner_button_link,
        icon: 'arrow-right',
        icon_only: true,
        style: 'primary',
        size: 'medium'
      %}
    </div>
  {%- endif -%}
{%- endcapture -%}
{%- capture grid_banner_html -%}
  {%- if enable_grid_banner -%}
    {% render 'image-card',
      mode: 'static',
      image: grid_banner_image_html,
      overlay: grid_banner_overlay_html,
      color_scheme: section.settings.grid_banner_color_scheme,
      subheading: grid_banner_subheading,
      heading: grid_banner_heading,
      text: grid_banner_text,
      button: grid_banner_button,
      h_alignment: 'flex-start',
      v_alignment: 'space-between',
      edge_gap: 'sm',
      border_radius: settings.pcard_media_radius,
      classes: grid_banner_card_classes
    %}
  {%- endif -%}
{%- endcapture -%}
{%- capture media_sizes -%}
  {%- capture container_size -%}min(100vw, {{ settings.page_width | plus: 32 }}px){%- endcapture -%}
  {% if enable_filtering %}(min-width: 1200px) calc(({{ container_size }} - 345px - 32px) / {{ columns }}), (min-width: 1024px) calc(({{ container_size }} - 295px - 32px) / {{ columns }}), {% endif %}(min-width: 768px) calc(({{ container_size }} - 32px) / {{ columns }}), calc((100vw - 32px) / {{ columns_mobile }})
{%- endcapture -%}
<script
  src="{{ 'results-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>
<results-list
  class="collection main-collection spacing-style section-grid section-grid--{{ section.settings.container }}{% if collection.all_products_count == 0 %} collection-empty{% endif %} color-{{ section.settings.color_scheme }}"
  pagination-type="{{ section.settings.pagination }}"
  show-filtering="{% if enable_filtering and filter_type == 'vertical' %}true{% else %}false{% endif %}"
  preload="false"
  section-id="{{ section.id }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="collection__wrapper">
    {% render 'filters',
      section_settings: section.settings,
      results: collection,
      results_size: collection.products_count,
      total_products_count: collection.all_products_count
    %}
    {% paginate collection.products by section.settings.products_per_page %}
      {% capture children %}
        {% assign grid_banner_inserted = false %}
        {% for product in collection.products %}
          <li
            id="{{ section.id }}-{{ product.id }}"
            class="product-grid__item product-grid__item--{{ forloop.index0 }}"
            data-page="{{ paginate.current_page }}"
            data-product-id="{{ product.id }}"
            ref="cards[]"
          >
            {% # theme-check-disable %}
            {% content_for 'block', type: '_product-card', id: 'product-card', product: product, media_sizes: media_sizes %}
            {% # theme-check-enable %}
          </li>
          {% if enable_grid_banner and grid_banner_html != blank and forloop.index == grid_banner_position %}
            <li class="product-grid__item product-grid__item--banner {{ grid_banner_li_class }}" style="{{ grid_banner_shape_style }}" ref="cards[]">
              {{ grid_banner_html }}
            </li>
            {% assign grid_banner_inserted = true %}
          {% endif %}
        {% endfor %}
        {% if enable_grid_banner and grid_banner_html != blank and grid_banner_inserted == false %}
          <li class="product-grid__item product-grid__item--banner {{ grid_banner_li_class }}" style="{{ grid_banner_shape_style }}" ref="cards[]">
            {{ grid_banner_html }}
          </li>
        {% endif %}
      {% endcapture %}

      <div id="ResultsList" class="main-collection-grid">
        {% if collection.products.size == 0 %}
          <div class="main-collection-grid__empty flex flex-col gap-2 items-center justify-center">
            <h3 class="main-collection-grid__empty-title h2">
              {{ 'content.no_products_found' | t }}
            </h3>
            <p>
              {{ 'content.use_fewer_filters_html' | t: link: collection.url, class: 'main-collection-grid__empty-link link link--underline' }}
            </p>
          </div>
        {% else %}
          <div class="grid gap-6 xl:gap-8">
            {% if children != blank %}
              <ul
                class="product-grid gap-style list-unstyled layout-panel-grid"
                product-grid-view="{{ columns }}-columns"
                ref="grid"
                role="list"
                data-last-page="{{ paginate.pages }}"
                style="--f-columns-mobile: {{ columns_mobile }}; --f-columns-md: {{ columns }}; {% render 'gap-style', settings: section.settings %}"
              >
                {{- children -}}
              </ul>
            {% endif %}
            {% if paginate.pages > 1 %}
              {%- liquid
                assign ref = null
                if section.settings.pagination == 'load-more'
                  assign ref = 'loadMoreBtn'
                elsif section.settings.pagination == 'infinite'
                  assign ref = 'viewMoreNext'
                endif
              -%}
              {% render 'pagination', paginate: paginate, type: section.settings.pagination, ref: ref %}
            {% endif %}
          </div>
        {% endif %}
      </div>
    {% endpaginate %}
  </div>
</results-list>

{% unless request.design_mode %}
  <script>
    (() => {
      const grid = document.querySelector('.product-grid');

      if (grid) {
        const storedLayout = sessionStorage.getItem(`product-grid-view`);

        if (storedLayout) {
          const options = document.querySelectorAll(`input[type="radio"][name="grid"]`);

          grid.setAttribute('product-grid-view', storedLayout);

          for (const option of options) {
            option.checked = option.value === storedLayout;
          }
        }
      }
    })();
  </script>
{% endunless %}

{% schema %}
{
  "name": "t:names.main_collection",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "[Read How-to](https://go.foxecom.com/SJVK6sb)"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "container",
      "label": "t:settings.container",
      "options": [
        { "value": "full", "label": "t:options.full" },
        { "value": "fixed", "label": "t:options.fixed" }
      ],
      "default": "fixed"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:settings.products_per_page",
      "min": 12,
      "max": 48,
      "step": 1,
      "default": 24
    },
    {
      "type": "select",
      "id": "pagination",
      "label": "t:settings.pagination_type",
      "options": [
        { "value": "number", "label": "t:options.number" },
        { "value": "infinite", "label": "t:options.infinite" },
        { "value": "load-more", "label": "t:options.load_more" }
      ],
      "default": "number"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Banner in grid"
    },
    {
      "type": "checkbox",
      "id": "enable_grid_banner",
      "label": "Banner tonen tussen de producten",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "grid_banner_image",
      "label": "Achtergrondafbeelding",
      "visible_if": "{{ section.settings.enable_grid_banner == true }}"
    },
    {
      "type": "image_picker",
      "id": "grid_banner_image_mobile",
      "label": "Achtergrondafbeelding (mobiel)",
      "info": "Optioneel, gebruikt anders de desktopafbeelding",
      "visible_if": "{{ section.settings.enable_grid_banner == true }}"
    },
    {
      "type": "select",
      "id": "grid_banner_image_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        { "value": "adapt", "label": "t:options.auto" },
        { "value": "1/1", "label": "t:options.square" },
        { "value": "4/5", "label": "t:options.portrait" },
        { "value": "3/4", "label": "t:options.portrait_3_4" },
        { "value": "16/9", "label": "t:options.landscape" },
        { "value": "4/3", "label": "t:options.landscape_4_3" },
        { "value": "21/9", "label": "t:options.landscape_21_9" }
      ],
      "default": "21/9",
      "visible_if": "{{ section.settings.enable_grid_banner == true }}"
    },
    {
      "type": "text",
      "id": "grid_banner_subtitle",
      "label": "Subtitel",
      "visible_if": "{{ section.settings.enable_grid_banner == true }}"
    },
    {
      "type": "color",
      "id": "grid_banner_subtitle_color",
      "label": "Kleur subtitel",
      "default": "#3e0c40",
      "visible_if": "{{ section.settings.enable_grid_banner == true }}"
    },
    {
      "type": "text",
      "id": "grid_banner_title",
      "label": "Titel",
      "visible_if": "{{ section.settings.enable_grid_banner == true }}"
    },
    {
      "type": "color",
      "id": "grid_banner_title_color",
      "label": "Kleur titel",
      "default": "#3e0c40",
      "visible_if": "{{ section.settings.enable_grid_banner == true }}"
    },
    {
      "type": "select",
      "id": "grid_banner_title_preset",
      "label": "t:settings.preset",
      "options": [
        { "value": "rte", "label": "t:options.default" },
        { "value": "paragraph", "label": "t:options.paragraph" },
        { "value": "text-subheading", "label": "t:options.subheading" },
        { "value": "h1", "label": "t:options.h1" },
        { "value": "h2", "label": "t:options.h2" },
        { "value": "h3", "label": "t:options.h3" },
        { "value": "h4", "label": "t:options.h4" },
        { "value": "h5", "label": "t:options.h5" },
        { "value": "h6", "label": "t:options.h6" },
        { "value": "custom", "label": "t:options.custom" }
      ],
      "default": "h4",
      "visible_if": "{{ section.settings.enable_grid_banner == true }}"
    },
    {
      "type": "select",
      "id": "grid_banner_title_font",
      "label": "t:settings.font",
      "options": [
        { "value": "var(--font-body--family)", "label": "t:options.body" },
        { "value": "var(--font-heading--family)", "label": "t:options.heading" }
      ],
      "default": "var(--font-heading--family)",
      "visible_if": "{{ section.settings.enable_grid_banner == true and section.settings.grid_banner_title_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "grid_banner_title_font_weight",
      "label": "t:settings.font_weight",
      "default": "",
      "options": [
        { "value": "", "label": "t:options.inherit" },
        { "value": "300", "label": "t:options.light" },
        { "value": "400", "label": "t:options.regular" },
        { "value": "500", "label": "t:options.medium" },
        { "value": "600", "label": "t:options.semi_bold" },
        { "value": "700", "label": "t:options.bold" },
        { "value": "800", "label": "t:options.extra_bold" },
        { "value": "900", "label": "t:options.black" }
      ],
      "visible_if": "{{ section.settings.enable_grid_banner == true and section.settings.grid_banner_title_preset == 'custom' }}"
    },
    {
      "type": "range",
      "id": "grid_banner_title_font_size",
      "label": "t:settings.font_size",
      "default": 28,
      "min": 12,
      "max": 100,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_grid_banner == true and section.settings.grid_banner_title_preset == 'custom' }}"
    },
    {
      "type": "range",
      "id": "grid_banner_title_font_size_mobile",
      "label": "t:settings.font_size_mobile",
      "default": 22,
      "min": 12,
      "max": 60,
      "step": 1,
      "unit": "px",
      "visible_if": "{{ section.settings.enable_grid_banner == true and section.settings.grid_banner_title_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "grid_banner_title_line_height",
      "label": "t:settings.line_height",
      "options": [
        { "value": "tight", "label": "t:options.tight" },
        { "value": "normal", "label": "t:options.normal" },
        { "value": "loose", "label": "t:options.loose" }
      ],
      "default": "normal",
      "visible_if": "{{ section.settings.enable_grid_banner == true and section.settings.grid_banner_title_preset == 'custom' }}"
    },
    {
      "type": "select",
      "id": "grid_banner_title_highlight_style",
      "label": "t:settings.highlight_style",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "standard", "label": "t:options.standard" },
        { "value": "wavy-underline", "label": "t:options.wavy_underline" },
        { "value": "solid-background", "label": "t:options.solid_background" }
      ],
      "default": "none",
      "visible_if": "{{ section.settings.enable_grid_banner == true }}"
    },
    {
      "type": "select",
      "id": "grid_banner_title_highlight_font_style",
      "label": "t:settings.highlight_font_style",
      "options": [
        { "value": "italic", "label": "t:options.italic" },
        { "value": "normal", "label": "t:options.normal" }
      ],
      "default": "italic",
      "visible_if": "{{ section.settings.enable_grid_banner == true and section.settings.grid_banner_title_highlight_style != 'none' }}"
    },
    {
      "type": "color",
      "id": "grid_banner_title_highlight_shape_color",
      "label": "t:settings.highlight_shape_color",
      "visible_if": "{{ section.settings.enable_grid_banner == true and section.settings.grid_banner_title_highlight_style != 'none' and section.settings.grid_banner_title_highlight_style != 'standard' }}"
    },
    {
      "type": "color",
      "id": "grid_banner_title_highlight_text_color",
      "label": "t:settings.highlight_text_color",
      "visible_if": "{{ section.settings.enable_grid_banner == true and section.settings.grid_banner_title_highlight_style != 'none' }}"
    },
    {
      "type": "richtext",
      "id": "grid_banner_text",
      "label": "Tekst",
      "visible_if": "{{ section.settings.enable_grid_banner == true }}"
    },
    {
      "type": "url",
      "id": "grid_banner_button_link",
      "label": "Link (pijltje rechtsonder)",
      "info": "Vierkant knopje met pijltje rechtsonder in de banner, alleen zichtbaar als hier een link is ingevuld",
      "visible_if": "{{ section.settings.enable_grid_banner == true }}"
    },
    {
      "type": "range",
      "id": "grid_banner_position",
      "label": "Positie in het grid",
      "info": "Na hoeveel producten de banner wordt getoond (op deze pagina)",
      "min": 1,
      "max": 48,
      "step": 1,
      "default": 4,
      "visible_if": "{{ section.settings.enable_grid_banner == true }}"
    },
    {
      "type": "select",
      "id": "grid_banner_width",
      "label": "Breedte van de banner",
      "info": "Hoeveel productblokjes breed de banner is",
      "options": [
        { "value": "1", "label": "1 productblok" },
        { "value": "2", "label": "2 productblokken" },
        { "value": "3", "label": "3 productblokken" }
      ],
      "default": "3",
      "visible_if": "{{ section.settings.enable_grid_banner == true }}"
    },
    {
      "type": "checkbox",
      "id": "grid_banner_show_shape",
      "label": "Schuin kleurvlak achter tekst tonen",
      "info": "Vlak met een schuine onderrand achter de subtitel, titel en tekst",
      "default": true,
      "visible_if": "{{ section.settings.enable_grid_banner == true }}"
    },
    {
      "type": "color",
      "id": "grid_banner_shape_color",
      "label": "Kleur kleurvlak",
      "default": "#ab85bc",
      "visible_if": "{{ section.settings.enable_grid_banner == true and section.settings.grid_banner_show_shape == true }}"
    },
    {
      "type": "checkbox",
      "id": "grid_banner_overlay",
      "label": "t:settings.media_overlay",
      "default": true,
      "visible_if": "{{ section.settings.enable_grid_banner == true }}"
    },
    {
      "type": "color",
      "id": "grid_banner_overlay_color",
      "label": "t:settings.overlay_color",
      "alpha": true,
      "default": "#00000033",
      "visible_if": "{{ section.settings.enable_grid_banner == true and section.settings.grid_banner_overlay == true }}"
    },
    {
      "type": "color_scheme",
      "id": "grid_banner_color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ section.settings.enable_grid_banner == true }}"
    },
    {
      "type": "header",
      "content": "t:content.filtering_and_sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:settings.enable_filtering",
      "info": "t:info.enable_filtering_info",
      "default": true
    },
    {
      "type": "select",
      "id": "filter_type",
      "options": [
        {
          "value": "vertical",
          "label": "t:options.vertical"
        },
        {
          "value": "drawer",
          "label": "t:options.drawer"
        }
      ],
      "default": "vertical",
      "label": "t:settings.desktop_filter_layout",
      "info": "t:info.desktop_filter_layout",
      "visible_if": "{{ section.settings.enable_filtering == true }}"
    },
    {
      "type": "checkbox",
      "id": "hide_filter_collapse_button",
      "label": "Verberg knop om filters in te klappen (desktop)",
      "info": "Verbergt de knop waarmee bezoekers de filterbalk op desktop kunnen dichtklappen.",
      "default": true,
      "visible_if": "{{ section.settings.enable_filtering == true and section.settings.filter_type == 'vertical' }}"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:settings.enable_sorting",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_grid_density",
      "label": "t:settings.enable_grid_density",
      "default": true
    },
    {
      "type": "text",
      "id": "expand_filter_groups",
      "label": "t:settings.expand_filter_groups",
      "info": "t:info.expand_filter_groups_info"
    },
    {
      "type": "header",
      "content": "t:content.mobile_layout"
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "label": "t:settings.horizontal_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "t:settings.vertical_gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "select",
      "id": "device",
      "label": "t:settings.devices",
      "options": [
