              "blocks": {
                "accordion_row_aCPLfH": {
                  "type": "_accordion-row",
                  "settings": {
                    "text": "Hoe kan ik retourneren?",
                    "open_row_by_default": true,
                    "link": "",
                    "icon": "none",
