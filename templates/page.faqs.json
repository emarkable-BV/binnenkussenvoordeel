                        "line_height": "normal",
                        "text_color": "subtext",
                        "text_color_gradient": "",
                        "disable_line_break_mobile": false,
                        "width": "fit-content",
                        "text_alignment": "left",
                        "width_mobile": "fit-content",
                        "text_alignment_mobile": "left",
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0,
                        "mobile-padding-scale": 80,
                        "animation_type": "none",
                        "animation_delay": 250
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_U8eTXC"
                  ]
                },
                "accordion_row_rQbbwV": {
                  "type": "_accordion-row",
                  "settings": {
                    "text": "Het gewicht van mijn binnenkussen wijkt iets af, hoe kan dit?",
                    "open_row_by_default": false,
                    "link": "",
                    "icon": "none",
                    "icon_size": "extra-large",
                    "width": 24,
                    "width_mobile": 24
                  },
                  "blocks": {
                    "text_gQgJ7i": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Bij natuurlijke vullingen zoals dons en veren kunnen kleine gewichtsverschillen voorkomen, dit hoort bij het productieproces. Wijkt het gewicht sterk af van de specificaties, neem dan contact op met foto's en je bestelnummer, dan kijken we met je mee.</p>",
                        "highlight_style": "none",
                        "highlight_font_style": "italic",
                        "highlight_shape_color": "",
                        "highlight_text_color": "",
                        "type_preset": "rte",
                        "font": "var(--font-body--family)",
                        "font_weight": "",
                        "font_size": 15,
                        "font_size_mobile": 15,
                        "line_height": "normal",
                        "text_color": "subtext",
                        "text_color_gradient": "",
                        "disable_line_break_mobile": false,
                        "width": "fit-content",
                        "text_alignment": "left",
                        "width_mobile": "fit-content",
                        "text_alignment_mobile": "left",
                        "padding-block-start": 0,
                        "padding-block-end": 0,
                        "padding-inline-start": 0,
                        "padding-inline-end": 0,
                        "mobile-padding-scale": 80,
                        "animation_type": "none",
                        "animation_delay": 250
                      },
                      "blocks": {}
                    }
                  },
                  "block_order": [
                    "text_gQgJ7i"
                  ]
                },
                "accordion_row_6E7qUP": {
                  "type": "_accordion-row",
                  "settings": {
                    "text": "Kan ik mijn binnenkussen wassen?",
                    "open_row_by_default": false,
                    "link": "",
                    "icon": "none",
                    "icon_size": "extra-large",
                    "width": 24,
                    "width_mobile": 24
                  },
                  "blocks": {
                    "text_q8HLtQ": {
                      "type": "text",
                      "settings": {
                        "text": "<p>Dat hangt van de vulling af:</p><ul><li><strong>Polyester:</strong> niet wassen, bleken of strijken, wel drogen op lage temperatuur.</li><li><strong>Dons/veren:</strong> niet wassen, bleken of strijken.</li><li><strong>Memory foam:</strong> niet wassen, regelmatig luchten volstaat.</li></ul><p>Schud je binnenkussen af en toe op, dat houdt de vulling luchtig en verlengt de levensduur.</p>",
                        "highlight_style": "none",
