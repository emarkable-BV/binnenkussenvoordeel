                "link": "",
                "icon": "none",
                "icon_size": "custom-size",
                "width": 32,
                "width_mobile": 24
              },
              "blocks": {
                "text_dc77ab": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Dat hangt af van wat je belangrijk vindt. Polyester is licht en vormvast, memory foam geeft een stevig en ondersteunend gevoel en veren/dons zorgen voor een zachte, luxe en goed vormbare uitstraling.</p>",
                    "highlight_style": "none",
                    "highlight_font_style": "italic",
                    "highlight_shape_color": "",
                    "highlight_text_color": "",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_weight": "",
                    "font_size": 15,
                    "font_size_mobile": 15,
                    "line_height": "normal",
                    "text_color": "subtext",
                    "text_color_gradient": "",
                    "disable_line_break_mobile": false,
                    "width": "100%",
