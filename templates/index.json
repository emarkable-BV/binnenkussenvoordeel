            "accordion_row_qxRhXi": {
              "type": "_accordion-row",
              "settings": {
                "text": "Welke maat binnenkussen heb ik nodig?",
                "open_row_by_default": false,
                "link": "",
                "icon": "none",
                "icon_size": "custom-size",
                "width": 32,
                "width_mobile": 24
              },
              "blocks": {
                "text_gnGBH6": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Dit hangt af van de maat van je kussenhoes en de gewenste uitstraling. Voor een mooi gevuld sierkussen wordt vaak gekozen voor een binnenkussen dat iets groter is dan de hoes. Bij een hoes van 45 × 45 cm kan bijvoorbeeld een binnenkussen van 50 × 50 cm zorgen voor een vollere uitstraling.</p>",
                    "highlight_style": "none",
                    "highlight_font_style": "italic",
                    "highlight_shape_color": "",
                    "highlight_text_color": "",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
                    "font_weight": "",
                    "font_size": 15,
                    "font_size_mobile": 15,
                    "line_height": "normal",
                    "text_color": "subtext",
                    "text_color_gradient": "",
                    "disable_line_break_mobile": false,
                    "width": "100%",
                    "text_alignment": "left",
                    "width_mobile": "100%",
                    "text_alignment_mobile": "left",
                    "padding-block-start": 0,
                    "padding-block-end": 0,
                    "padding-inline-start": 0,
                    "padding-inline-end": 0,
                    "mobile-padding-scale": 80,
                    "animation_type": "none",
                    "animation_delay": 250
                  },
                  "blocks": {}
                }
              },
