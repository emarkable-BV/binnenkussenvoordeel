              "blocks": {
                "text_wbTkbQ": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Dit is afhankelijk van de samenstelling van de betreffende bundel. Bekijk daarom altijd de specificaties van de bundel om te zien welke maten inbegrepen zijn.</p>",
