                "width": 32,
                "width_mobile": 24
              },
              "blocks": {
                "text_q67y33": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Ja. De bundels zijn juist samengesteld voor wie meerdere kussens nodig heeft en bieden daardoor meer voordeel dan wanneer je dezelfde hoeveelheid los bestelt.</p>",
                    "highlight_style": "none",
