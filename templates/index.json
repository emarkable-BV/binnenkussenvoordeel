                "width": 32,
                "width_mobile": 24
              },
              "blocks": {
                "text_xdgxpb": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Voor een zachte, volle en luxe uitstraling zijn veren/dons een populaire keuze. Ook memory foam kan zorgen voor een stevig en rijk gevuld sierkussen.</p>",
                    "highlight_style": "none",
                    "highlight_font_style": "italic",
