                "icon_size": "custom-size",
                "width": 32,
                "width_mobile": 24
              },
              "blocks": {
                "text_qJkNyH": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Zeker. Naast onze bundels kun je ook losse binnenkussens bestellen. Heb je meerdere kussens nodig? Dan is een bundel de voordeligste keuze.</p>",
                    "highlight_style": "none",
                    "highlight_font_style": "italic",
                    "highlight_shape_color": "",
                    "highlight_text_color": "",
                    "type_preset": "rte",
                    "font": "var(--font-body--family)",
