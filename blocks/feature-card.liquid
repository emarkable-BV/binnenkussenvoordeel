<div
  class="feature-card feature-card--{{ block.id }} relative flex justify-between"
  style="background-color: {{ block.settings.background_color }};"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.link != blank -%}
    <a
      href="{{ block.settings.link }}"
      class="absolute inset-0 focus-visible--absolute"
      aria-label="{{ block.settings.heading | escape }}"
    ></a>
  {%- endif -%}
  <div class="feature-card__content flex flex-col">
    <h3 class="feature-card__heading h4">{{ block.settings.heading }}</h3>
    {%- if block.settings.link != blank -%}
      {% render 'button',
        label: block.settings.link_label,
        link: block.settings.link,
        style: 'plain',
        size: 'small',
        icon: 'caret-right',
        icon_style: 'solid',
        with_wrapper: false
      %}
    {%- endif -%}
  </div>
  {%- if block.settings.image != blank -%}
    <div class="feature-card__media shrink-0">
      {% render 'responsive-image',
        mode: 'js',
        image: block.settings.image,
        default_alt: block.settings.heading,
        with_wrapper: false,
        class: 'feature-card__image'
      %}
    </div>
  {%- endif -%}
</div>
<style>
  .feature-card--{{ block.id }} {
    flex: 1 1 0%;
    min-width: 0;
    border-radius: 12px;
    overflow: hidden;
  }

  .feature-card--{{ block.id }} .feature-card__content {
    gap: 4px;
    padding: 20px;
    justify-content: center;
  }

  .feature-card--{{ block.id }} .feature-card__media {
    width: 140px;
    align-self: stretch;
  }

  .feature-card--{{ block.id }} .feature-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--animation-duration--medium, 240ms) var(--animation-easing--smooth, ease);
  }

  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .feature-card--{{ block.id }}:hover .feature-card__image {
      transform: scale(1.08);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .feature-card--{{ block.id }}:hover .btn__text::after {
      inset-inline: 0 auto;
      width: 100%;
    }
  }

  @media screen and (max-width: 749px) {
    .feature-card--{{ block.id }} {
      width: 100%;
    }

    .feature-card--{{ block.id }} .feature-card__content {
      padding: 16px;
      padding-inline-start: 24px;
    }

    .feature-card--{{ block.id }} .feature-card__heading {
      font-size: var(--font-size--h3);
      line-height: var(--font-h3--line-height);
    }

    .feature-card--{{ block.id }} .btn {
      display: none;
    }

    .feature-card--{{ block.id }} .feature-card__media {
      width: 84px;
    }
  }
</style>

{% schema %}
{
  "name": "t:names.feature_card",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "t:content.content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Heading"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.label",
      "default": "Bekijken",
      "visible_if": "{{ block.settings.link != blank }}"
    },
    {
      "type": "header",
      "content": "t:content.image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#fdf8f4"
    }
  ],
  "presets": [
    {
      "name": "t:names.feature_card",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
