{%- liquid
  assign heading = block.settings.heading | default: settings.contact_heading
  assign phone = settings.contact_phone
  assign email = settings.contact_email
  assign image = block.settings.image
  assign image_size = block.settings.image_size | default: 100
  assign image_size_px = image_size | append: 'px'

  assign phone_href = phone | remove: ' ' | remove: '-'
-%}
<div
  class="contact-card border-style flex items-center{% unless block.settings.inherit_color_scheme %} color-{{ block.settings.color_scheme }}{% endunless %}"
  style="{% render 'border-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {%- if image != blank -%}
    <div class="contact-card__image shrink-0 media-mask-clip" style="--contact-card-image-size: {{ image_size }}px;">
      {% render 'responsive-image',
        mode: 'liquid',
        image: image,
        image_ratio: '1/1',
        default_alt: heading,
        media_width_desktop: image_size_px,
        media_width_mobile: image_size_px
      %}
    </div>
  {%- endif -%}
  <div class="contact-card__content flex flex-col">
    {%- if heading != blank -%}
      <div class="contact-card__heading h6{% if block.settings.remove_heading_spacing %} contact-card__heading--tight{% endif %}">{{ heading }}</div>
    {%- endif -%}
    <div class="contact-card__details flex flex-col">
      {%- if block.settings.show_phone and phone != blank -%}
        <a
          href="tel:{{ phone_href }}"
          class="contact-card__row flex items-center gap-2 text-decoration-none color-current"
          aria-label="{{ 'accessibility.call_phone_number' | t: phone: phone }}"
        >
          {% render 'icon', icon: 'phone', size: 'small' %}
          <span>{{ phone }}</span>
        </a>
      {%- endif -%}
      {%- if block.settings.show_email and email != blank -%}
        <a
          href="mailto:{{ email }}"
          class="contact-card__row flex items-center gap-2 text-decoration-none color-current"
          aria-label="{{ 'accessibility.email_address' | t: email: email }}"
        >
          {% render 'icon', icon: 'email', size: 'small' %}
          <span>{{ email }}</span>
        </a>
      {%- endif -%}
      {%- if block.settings.show_chat_link and settings.contact_chat_link != blank -%}
        <a
          href="{{ settings.contact_chat_link }}"
          class="contact-card__row btn--plain flex items-center gap-2 text-decoration-none color-current"
        >
          {% render 'icon', icon: 'chat-teardrop', size: 'small' %}
          <span class="btn__text">{{ block.settings.chat_label }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</div>
{% stylesheet %}
.contact-card {
  padding: 1rem 2rem 1rem 1rem;
  gap: 1.6rem;
  width: fit-content;
  min-width: 32rem;
}
.contact-card__image {
  width: var(--contact-card-image-size, 10rem);
  border-radius: 0.8rem;
  overflow: hidden;
}
.contact-card__heading {
  font-weight: 600;
  margin-bottom: 0.8rem;
}
.contact-card__heading--tight {
  margin-bottom: 0;
}
.contact-card__details {
  gap: 0.4rem;
}
@media (max-width: 767.98px) {
  .contact-card {
    display: none;
  }
}
{% endstylesheet %}
{% schema %}
{
  "name": "t:names.contact_card",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.contact_block_info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Aangepaste titel",
      "info": "Laat leeg om de standaardtitel uit de thema-instellingen te gebruiken"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Afbeeldingsgrootte",
      "min": 40,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "remove_heading_spacing",
      "label": "Ruimte onder titel verwijderen",
      "default": false
    },
    {
      "type": "header",
      "content": "Contactopties"
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Telefoonnummer tonen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "E-mailadres tonen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_chat_link",
      "label": "Chat-link tonen",
      "info": "Link zelf instellen bij Thema-instellingen → Contactblok",
      "default": false
    },
    {
      "type": "text",
      "id": "chat_label",
      "label": "Chat-linktekst",
      "default": "Start chat",
      "visible_if": "{{ block.settings.show_chat_link == true }}"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.borders",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "solid", "label": "t:options.solid" }
      ],
      "default": "solid"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 3,
      "step": 0.5,
      "unit": "px",
      "label": "t:settings.border_width",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.border_opacity",
      "default": 10,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "t:names.contact_card"
    }
  ]
}
{% endschema %}
