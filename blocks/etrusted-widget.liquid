{%- doc -%}
  Renders an eTrusted review widget by its widget ID. The eTrusted
  bootstrap script (integrations.etrusted.com/applications/widget.js)
  is loaded once site-wide from layout/theme.liquid. Falls back to the
  default widget ID in theme settings (Trusted Shops) when left blank.
{%- enddoc -%}

{%- liquid
  assign widget_id = block.settings.widget_id | default: settings.etrusted_widget_id
-%}

<div class="etrusted-widget-block" {{ block.shopify_attributes }}>
  {%- if widget_id != blank -%}
    <etrusted-widget data-etrusted-widget-id="{{ widget_id }}"></etrusted-widget>
  {%- endif -%}
</div>

{% stylesheet %}
  .etrusted-widget-block {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
  }
  .etrusted-widget-block etrusted-widget {
    display: block;
    width: 100%;
    max-width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "eTrusted widget",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "widget_id",
      "label": "Widget-ID",
      "info": "De 'data-etrusted-widget-id' waarde uit eTrusted, bijv. wdg-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx. Leeg laten om de standaard widget-ID uit de theme-instellingen (Trusted Shops) te gebruiken."
    }
  ],
  "presets": [
    {
      "name": "eTrusted widget"
    }
  ]
}
{% endschema %}
